# Jalankan `python scripts/init_env.py` untuk membuat .env dari berkas ini
# dengan rahasia acak. Berkas .env tidak ikut masuk git.

ERPNEXT_VERSION=v15
SITE_NAME=siaga.localhost
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=ubah-saya

HTTP_PORT=8080

TIMESCALE_USER=siaga
TIMESCALE_PASSWORD=ubah-saya
TIMESCALE_DB=siaga_ts
TIMESCALE_PORT=5432

MQTT_PORT=1883

# Faktor percepatan replay: 1 = waktu asli, 600 = satu cuplikan per detik
# (seluruh dataset 7 hari selesai dalam 16 menit), 0 = tanpa jeda.
REPLAY_SPEED=600

# Detik antar siklus AI service.
AI_INTERVAL=30

# Telegram (opsional). Buat bot lewat @BotFather untuk token. Chat id: kirim
# /start ke bot setelah stack jalan, bot membalas dengan chat id Anda; atau
# jalankan scripts/telegram_chat_id.py sebelum stack jalan. Chat ini menerima
# notifikasi dan ditautkan ke planner saat bootstrap, jadi tombol Mulai/Selesai
# di pesan alarm langsung bisa dipakai. User lain ditautkan lewat Telegram Chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alamat ERPNext yang bisa dibuka dari HP, dipakai untuk tautan di pesan.
PUBLIC_URL=http://localhost:8080

# Kredensial user siaga-bot yang dipakai AI service. Bootstrap membuat user
# itu dengan kunci ini, jadi keduanya harus terisi (init_env.py mengacaknya).
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Perusahaan demo yang dibuat setup wizard otomatis.
SIAGA_COMPANY=PT Tambang Demo
SIAGA_COMPANY_ABBR=PTD
SIAGA_ADMIN_EMAIL=planner@siaga.local
SIAGA_ADMIN_NAME=Maintenance Planner
