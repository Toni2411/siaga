# Salin jadi .env sebelum menjalankan docker compose.
# Berkas .env tidak ikut masuk git.

ERPNEXT_VERSION=v15
SITE_NAME=siaga.localhost
ADMIN_PASSWORD=admin
DB_ROOT_PASSWORD=ubah-saya

HTTP_PORT=8080

TIMESCALE_USER=siaga
TIMESCALE_PASSWORD=ubah-saya
TIMESCALE_DB=siaga_ts
TIMESCALE_PORT=5432

MQTT_PORT=1883

# Faktor percepatan replay: 1 = waktu asli, 600 = satu cuplikan per detik
# (seluruh dataset 7 hari selesai dalam 16 menit), 0 = tanpa jeda.
REPLAY_SPEED=600

# Detik antar siklus AI service.
AI_INTERVAL=30

# Kredensial yang dipakai AI service saat memanggil ERPNext. Dibuat setelah
# site hidup, lewat user khusus siaga-bot dengan role terbatas, bukan
# Administrator.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
